# Copy this file to `.env` and fill in the values you have.
# Every setting is optional -- the platform falls back to its offline simulation
# engine whenever a credential is missing, so the demo always runs.

# Sarvam AI subscription key. Enables live Saaras speech-to-text, Bulbul
# text-to-speech and Mayura translation. Get one at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Comma-separated list of browser origins allowed to call the API.
# Wildcards are intentionally unsupported because the API sends credentials.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
